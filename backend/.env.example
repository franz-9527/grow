# 启动前请将此文件复制为与 app/ 同级的 `.env` 文件。
# 程序会自动读取 `.env`；如果系统环境变量已设置同名项，则优先使用系统环境变量。
GROW_DATA_DIR=data
# 可选：静态前端目录的绝对路径覆盖项；默认使用 backend/static/client。
# GROW_STATIC_DIR=/www/wwwroot/grow/static/client
# 所有菜园管理写入操作都需要 4 位管理密码。浏览页面可保持公开；正式部署前务必修改示例值。
GROW_ADMIN_PIN=
# 可选：设置一段足够长的随机字符串；修改后会使所有现有管理会话失效。
# GROW_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# 七牛 Kodo 图片存储配置。程序会自动以 grow/ 为前缀，分别存入地块、作物、生长记录和物资目录。
QINIU_BUCKET=
# 存储区域：z0 代表华东-浙江。
QINIU_REGION=z0
QINIU_UPLOAD_URL=https://up-z0.qiniup.com
# 填写自己的图片访问域名，并使用该域名实际支持的 HTTP/HTTPS 协议。
QINIU_PUBLIC_BASE_URL=
# 这两个密钥只能保存在后端私有 `.env`，绝不能写入前端代码或公开文件。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
# 上传令牌的有效时间（秒）。
QINIU_TOKEN_TTL=1800
# 图片处理完成后的文件大小上限：2 MB。服务端会始终将其限制在 2 MB 以内。
QINIU_MAX_IMAGE_BYTES=2097152
# 原图上传到服务端前的大小上限：16 MB，用于给服务端缩放和无损编码留出空间。
QINIU_MAX_SOURCE_IMAGE_BYTES=16777216
# 图片最长边限制：2048 像素（2K）。超出时会先等比例缩小，再使用无损 WebP 编码。
QINIU_MAX_IMAGE_EDGE=2048
