# Save privately as /www/deploy/grow/deploy.env; chmod 600.
# Use the exact virtualenv interpreter shown in the existing BaoTa Python project.
PYTHON_BIN=/absolute/path/to/existing/venv/bin/python
NODE_BIN_DIR=/absolute/path/to/node22/bin
# A local executable script using the EXISTING project's actual process manager.
# It must accept stop/start, wait until stopped/started, and return nonzero on failure.
CONTROL_SCRIPT=/www/deploy/grow/control.sh
RUN_USER=www
HEALTH_URL=http://127.0.0.1:8010/health
